{
  "name": "markdown-studio-local",
  "displayName": "Markdown Studio: Local PDF Export",
  "description": "%extension.description%",
  "version": "1.0.4",
  "publisher": "kino6",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kino-6/vscode-markdown-studio.git"
  },
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Formatters"
  ],
  "keywords": [
    "markdown",
    "preview",
    "pdf",
    "mermaid",
    "plantuml",
    "wavedrom",
    "svg",
    "math",
    "toc",
    "export",
    "offline",
    "local",
    "latex",
    "katex",
    "bookmarks",
    "documentation",
    "technical-docs"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "icon": "icon/icon.png",
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markdownStudio.openPreview",
        "title": "%command.openPreview.title%"
      },
      {
        "command": "markdownStudio.openPreviewInCurrentTab",
        "title": "%command.openPreviewInCurrentTab.title%"
      },
      {
        "command": "markdownStudio.openPreviewFullWidth",
        "title": "%command.openPreviewFullWidth.title%"
      },
      {
        "command": "markdownStudio.exportPdf",
        "title": "%command.exportPdf.title%"
      },
      {
        "command": "markdownStudio.validateEnvironment",
        "title": "%command.validateEnvironment.title%"
      },
      {
        "command": "markdownStudio.reloadPreview",
        "title": "%command.reloadPreview.title%"
      },
      {
        "command": "markdownStudio.setupDependencies",
        "title": "%command.setupDependencies.title%"
      },
      {
        "command": "markdownStudio.insertToc",
        "title": "%command.insertToc.title%"
      },
      {
        "command": "markdownStudio.importExportProfile",
        "title": "%command.importExportProfile.title%"
      },
      {
        "command": "markdownStudio.exportProfileToJson",
        "title": "%command.exportProfileToJson.title%"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "markdownStudio.plantuml.mode": {
          "type": "string",
          "default": "bundled-jar",
          "enum": [
            "bundled-jar",
            "external-command",
            "docker"
          ],
          "description": "%configuration.plantuml.mode.description%"
        },
        "markdownStudio.java.path": {
          "type": "string",
          "default": "java",
          "description": "%configuration.java.path.description%"
        },
        "markdownStudio.export.pageFormat": {
          "type": "string",
          "default": "A4",
          "enum": [
            "A3",
            "A4",
            "A5",
            "Letter",
            "Legal",
            "Tabloid"
          ],
          "description": "%configuration.export.pageFormat.description%"
        },
        "markdownStudio.security.blockExternalLinks": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.security.blockExternalLinks.description%",
          "deprecationMessage": "%configuration.security.blockExternalLinks.deprecationMessage%"
        },
        "markdownStudio.security.externalResources.mode": {
          "type": "string",
          "default": "whitelist",
          "enum": [
            "block-all",
            "whitelist",
            "allow-all"
          ],
          "enumDescriptions": [
            "%configuration.security.externalResources.mode.enum.blockAll%",
            "%configuration.security.externalResources.mode.enum.whitelist%",
            "%configuration.security.externalResources.mode.enum.allowAll%"
          ],
          "description": "%configuration.security.externalResources.mode.description%"
        },
        "markdownStudio.security.externalResources.allowedDomains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "github.com",
            "raw.githubusercontent.com",
            "user-images.githubusercontent.com"
          ],
          "description": "%configuration.security.externalResources.allowedDomains.description%"
        },
        "markdownStudio.export.header.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.export.header.enabled.description%"
        },
        "markdownStudio.export.header.template": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "%configuration.export.header.template.description%"
        },
        "markdownStudio.export.footer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.export.footer.enabled.description%"
        },
        "markdownStudio.export.footer.template": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "%configuration.export.footer.template.description%"
        },
        "markdownStudio.export.pageBreak.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.export.pageBreak.enabled.description%"
        },
        "markdownStudio.export.pdfIndex.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%configuration.export.pdfIndex.enabled.markdownDescription%"
        },
        "markdownStudio.export.pdfIndex.title": {
          "type": "string",
          "default": "Table of Contents",
          "markdownDescription": "%configuration.export.pdfIndex.title.markdownDescription%"
        },
        "markdownStudio.export.pdfToc.hidden": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%configuration.export.pdfToc.hidden.markdownDescription%"
        },
        "markdownStudio.export.pdfBookmarks.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%configuration.export.pdfBookmarks.enabled.markdownDescription%"
        },
        "markdownStudio.export.cover.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%configuration.export.cover.enabled.markdownDescription%"
        },
        "markdownStudio.export.cover.path": {
          "type": "string",
          "default": "cover.md",
          "markdownDescription": "%configuration.export.cover.path.markdownDescription%"
        },
        "markdownStudio.preview.theme": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "enumDescriptions": [
            "%configuration.preview.theme.enum.auto%",
            "%configuration.preview.theme.enum.light%",
            "%configuration.preview.theme.enum.dark%"
          ],
          "description": "%configuration.preview.theme.description%"
        },
        "markdownStudio.preview.contentWidth": {
          "type": "string",
          "default": "a4",
          "enum": [
            "a4",
            "full"
          ],
          "enumDescriptions": [
            "%configuration.preview.contentWidth.enum.a4%",
            "%configuration.preview.contentWidth.enum.full%"
          ],
          "description": "%configuration.preview.contentWidth.description%"
        },
        "markdownStudio.preview.sourceJump.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.preview.sourceJump.enabled.description%"
        },
        "markdownStudio.style.preset": {
          "type": "string",
          "default": "markdown-pdf",
          "enum": [
            "markdown-pdf",
            "github",
            "minimal",
            "academic",
            "custom"
          ],
          "markdownDescription": "%configuration.style.preset.markdownDescription%"
        },
        "markdownStudio.style.fontFamily": {
          "type": "string",
          "default": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif",
          "markdownDescription": "%configuration.style.fontFamily.markdownDescription%"
        },
        "markdownStudio.style.fontSize": {
          "type": "number",
          "default": 14,
          "markdownDescription": "%configuration.style.fontSize.markdownDescription%"
        },
        "markdownStudio.style.lineHeight": {
          "type": "number",
          "default": 1.6,
          "markdownDescription": "%configuration.style.lineHeight.markdownDescription%"
        },
        "markdownStudio.style.theme": {
          "type": "string",
          "default": "markdown-pdf",
          "enum": [
            "default",
            "modern",
            "markdown-pdf",
            "minimal"
          ],
          "enumDescriptions": [
            "%configuration.style.theme.enum.default%",
            "%configuration.style.theme.enum.modern%",
            "%configuration.style.theme.enum.markdownPdf%",
            "%configuration.style.theme.enum.minimal%"
          ],
          "markdownDescription": "%configuration.style.theme.markdownDescription%"
        },
        "markdownStudio.style.customCss": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "markdownDescription": "%configuration.style.customCss.markdownDescription%"
        },
        "markdownStudio.export.margin": {
          "type": "string",
          "default": "20mm",
          "description": "%configuration.export.margin.description%"
        },
        "markdownStudio.toc.levels": {
          "type": "string",
          "default": "1-3",
          "description": "%configuration.toc.levels.description%"
        },
        "markdownStudio.toc.orderedList": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.toc.orderedList.description%"
        },
        "markdownStudio.toc.pageBreak": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.toc.pageBreak.description%"
        },
        "markdownStudio.codeBlock.lineNumbers": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.codeBlock.lineNumbers.description%"
        },
        "markdownStudio.export.outputFilename": {
          "type": "string",
          "default": "${filename}",
          "markdownDescription": "%configuration.export.outputFilename.markdownDescription%"
        },
        "markdownStudio.export.diagramTimeout": {
          "type": "number",
          "default": 0,
          "markdownDescription": "%configuration.export.diagramTimeout.markdownDescription%"
        },
        "markdownStudio.network.caCertificates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%configuration.network.caCertificates.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "node config/esbuild.js",
    "watch": "node config/esbuild.js --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run -c config/vitest.config.ts",
    "test:unit": "vitest run -c config/vitest.unit.config.ts",
    "test:integration": "vitest run -c config/vitest.integration.config.ts",
    "pretest:e2e": "tsc -p config/tsconfig.e2e.json && npm run build",
    "test:e2e": "vscode-test --config config/vscode-test.mjs",
    "test:ci": "npm run lint && npm run test:unit && npm run test:integration",
    "test:preview-runtime": "npm run build && node scripts/test/previewRuntimeCheck.js",
    "test:demo-render": "npm run build && node scripts/test/demoRenderCheck.js",
    "package": "npm run build && rm -f dist/*.vsix && npm exec -- vsce package -o dist/",
    "reinstall": "bash scripts/dev/reinstall.sh",
    "demo": "npx tsx scripts/demo/index.ts",
    "demo:marketplace-gif": "npm run build && node scripts/demo/marketplaceGif.js",
    "benchmark:preview": "npm run build && node scripts/benchmark/previewBenchmark.js",
    "benchmark:pdf": "npm run build && node scripts/benchmark/pdfExportBenchmark.js",
    "corpus:check": "node scripts/corpus/runCorpusChecks.js",
    "repro:about-blank-footer": "node scripts/repro/aboutBlankFooter.js"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "^1.1.2",
    "highlight.js": "^11.11.1",
    "https-proxy-agent": "^7.0.6",
    "json5": "^2.2.3",
    "markdown-it": "^14.1.0",
    "markdown-it-deflist": "^3.0.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "pdf-lib": "^1.17.1",
    "playwright-core": "1.59.1",
    "sanitize-html": "^2.17.0",
    "tar-stream": "^3.1.7",
    "wavedrom": "^3.5.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@types/sanitize-html": "^2.16.0",
    "@types/tar-stream": "^3.1.0",
    "@types/vscode": "^1.92.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.24.0",
    "fast-check": "^4.6.0",
    "mermaid": "^11.12.0",
    "playwright": "1.59.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
