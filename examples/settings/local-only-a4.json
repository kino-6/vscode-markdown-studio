{
  "schemaVersion": 1,
  "name": "LocalOnly A4",
  "source": "manual-export",
  "pageFormat": "A4",
  "stylePreset": "minimal",
  "styleTheme": "minimal",
  "fontSize": 14,
  "lineHeight": 1.65,
  "margin": "20mm",
  "customCss": "a { color: #0f766e; } blockquote { border-left: 3px solid #0f766e; padding-left: 12px; }",
  "securityMode": "block-all",
  "allowedDomains": [],
  "headerEnabled": false,
  "headerTemplate": null,
  "footerEnabled": true,
  "footerTemplate": null,
  "pageBreakEnabled": true,
  "includeBookmarks": true,
  "includePdfIndex": true,
  "pdfIndexTitle": "Contents",
  "hidePdfToc": true,
  "coverEnabled": false,
  "coverPath": "cover.md",
  "tocLevels": "1-3",
  "tocOrderedList": false,
  "tocPageBreak": true,
  "codeBlockLineNumbers": true,
  "outputFilename": "${filename}-local"
}
